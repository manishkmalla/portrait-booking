# Copy to .env for host-run commands (e.g. `npm --prefix api test`).
# `docker compose up --build` does NOT need this file — it has its own
# defaults baked into docker-compose.yml's `environment:` blocks, which this
# file mirrors. If a .env exists, docker compose loads it automatically and
# it overrides those inline defaults.

# Postgres (used by the db service and by DATABASE_URL/TEST_DATABASE_URL below)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# API — host-run defaults (Postgres reachable at localhost via the published port).
# Inside docker compose, the api service overrides these to use the `db` hostname.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
TEST_DATABASE_URL=postgres://booking:booking@localhost:5432/booking_test
JWT_SECRET=dev-only-change-me-min-32-characters-long
WEB_ORIGIN=http://localhost:5173
PORT=3000

# Web — Vite dev server proxy target for /api (host default: api on localhost).
# Inside docker compose, the web service overrides this to the `api` hostname.
API_PROXY_TARGET=http://localhost:3000
